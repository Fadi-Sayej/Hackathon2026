rules_version = '2';

// SmartShelf pilot Firestore rules.
//
// The app sits behind the Vercel Basic Auth gate, but Firestore is reachable
// directly over the internet, so these rules — not the gate — are what keep a
// real store's decision data from being world-readable/writable.
//
// Pilot posture: a single store, accessed by clients that sign in anonymously
// (see src/firebase.js → ensureAnonymousAuth). We require an auth token and
// scope all access to the store subtree. Everything else is denied.
//
// SETUP: enable Anonymous sign-in in the Firebase console
//   Authentication → Sign-in method → Anonymous → Enable
// and deploy these rules:
//   firebase deploy --only firestore:rules
//
// Before multi-store or wider exposure, tighten this: pin to specific store
// ids, add per-user ownership, and turn on App Check.

service cloud.firestore {
  match /databases/{database}/documents {

    match /stores/{storeId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
