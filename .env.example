# ── Live market context (weather / holidays / news) ──────────────────────────
# Off by default; the app uses static context until this is true. All of the
# values below are for the pilot store: YomYom, Kafr Qasim, Israel.
VITE_ENABLE_LIVE_MARKET_CONTEXT=false
VITE_HOLIDAY_COUNTRY=IL
# Kafr Qasim coordinates (was Amman 31.95/35.93 — wrong country; fixed, B-5).
VITE_WEATHER_LAT=32.114
VITE_WEATHER_LON=34.972
VITE_NEWS_QUERY=Israel supermarket prices

# ── LLM proxy (FastAPI, enables real AI explanations) ────────────────────────
# Get your key at Google AI Studio → https://aistudio.google.com/apikey
# Gemini API keys start with 'AIza'.
#
# SERVER-SIDE ONLY — no VITE_ prefix. Vite inlines every VITE_* variable
# into the browser bundle, so a VITE_-prefixed key ships to every visitor
# in plain text. Only llm_proxy.py reads this; the frontend never sees it.
GEMINI_API_KEY=

# URL of the running llm_proxy.py server. Set this to enable real LLM explanations
# instead of the rule-based mock. Leave empty for deployed builds unless the proxy
# is also deployed over HTTPS. (Still commented out until the Gemini key is funded
# and the Track C async bug in explanationProvider.js is fixed — see nagham.md B-4.)
VITE_LLM_PROXY_URL=

# LLM proxy server config (src/api/llm_proxy.py). All optional with sane defaults.
# Comma-separated origins the proxy accepts CORS from. Set to the deployed frontend
# origin in production so it is not left open to localhost.
LLM_ALLOWED_ORIGINS=http://localhost:5173
# Hard timeout (seconds) on each upstream Gemini call, both /explain and /report.
LLM_UPSTREAM_TIMEOUT_SECONDS=3
# Response cache so an identical payload is not re-billed on every render.
# Keep MAX_ENTRIES above one pass over the recommendation list, or the LRU evicts
# the head of a pass before the next pass reaches it and the hit rate drops to ~0.
LLM_CACHE_TTL_SECONDS=3600
LLM_CACHE_MAX_ENTRIES=3000
# Override the Gemini model if needed. Server-side only (no VITE_ prefix — that
# would inline it into the browser bundle). Default is gemini-2.5-flash-lite:
# $0.10/1M in, $0.40/1M out, thinking off. Avoid gemini-2.5-flash here — it bills
# output at $2.50/1M and thinks by default, which this task does not need.
GEMINI_MODEL=gemini-2.5-flash-lite

# Max recommendations upgraded to a paid LLM explanation per pass. The rest keep
# the rule-based text. A full batch is ~2,100 rows and nobody reads past the top,
# so this is the single biggest lever on the bill.
VITE_LLM_MAX_EXPLANATIONS=40

# Server-side Vercel access gate. Set these in Vercel, not in client-side Vite env.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# ── Firebase (browser client — decisions & orders persistence, B-2) ──────────
# These are safe to expose in the client bundle: a Firebase web config is a
# project identifier, not a secret. Access is controlled by firestore.rules +
# the Vercel Basic Auth gate. Copy the values from the Firebase console →
# Project settings → General → "Your apps" → SDK setup and configuration.
# Leave these blank to keep persistence on localStorage only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=hackathon26-a6ebd.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hackathon26-a6ebd
VITE_FIREBASE_STORAGE_BUCKET=hackathon26-a6ebd.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Store namespace for the pilot (one store). Everything is written under
# stores/{VITE_STORE_ID}/... in Firestore.
VITE_STORE_ID=yomyom-kafr-qasim

# ── Comax POS connector (optional, stub) ─────────────────────────────────────
# Comax cannot be called from the browser; the connector stays a stub until a
# server-side proxy is deployed. Leave empty unless that backend exists.
VITE_COMAX_PROXY_URL=

# ── Python backend: Firestore writer ─────────────────────────────────────────
# Either provide the absolute path to the service-account JSON file…
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# …or paste the JSON inline (single line). The path takes precedence if both are set.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional: override the Firestore database id (defaults to "(default)")
FIREBASE_PROJECT_ID=hackathon26-a6ebd

# ── Kaggle API (automated dataset downloads) ─────────────────────────────────
# Get your token at kaggle.com → Settings → API Tokens → Generate New Token
KAGGLE_API_TOKEN=

# ── 10bis menu scraper (DISABLED) ────────────────────────────────────────────
# 10bis gates menus behind a personal user login. Automating that flow
# would violate the 10bis Terms of Service and require ongoing OTP/token
# maintenance, so the active pipeline relies on Wolt only.
#
# The tenbis_connector code is kept in the repo for reference / future use;
# uncomment and set TENBIS_BEARER_TOKEN below ONLY if you have a clear
# legal/business reason to do so.
# TENBIS_BEARER_TOKEN=
