{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smartshelf/dashboard.schema.json",
  "title": "SmartShelf dashboard artefact v2",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "run_id",
    "inputs_digest",
    "population",
    "run",
    "vintages",
    "thresholds",
    "value_kinds_present",
    "capabilities",
    "figures"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "generated_at": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "run": {
      "type": "object",
      "required": [
        "status",
        "steps"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "partial",
            "degraded"
          ]
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "step",
              "status"
            ],
            "properties": {
              "step": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "ok",
                  "error",
                  "skipped",
                  "degraded"
                ]
              },
              "ms": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "error": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "vintages": {
      "type": "object",
      "required": [
        "pos",
        "sales",
        "competitor",
        "owner_state"
      ],
      "properties": {
        "pos": {
          "type": "object",
          "required": [
            "file",
            "as_of"
          ],
          "properties": {
            "file": {
              "type": [
                "string",
                "null"
              ]
            },
            "as_of": {
              "type": [
                "string",
                "null"
              ]
            },
            "as_of_source": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "declared",
                "declared_sidecar",
                "git_commit",
                "file_mtime",
                null
              ],
              "description": "How as_of was arrived at. 'declared' (--as-of) and 'declared_sidecar' (<export>.vintage.json) are written down by a human and are the only ones certainly the export date. 'git_commit' is the file's last change in git, available only in a repository deep enough to answer — a shallow checkout returns the checkout commit's date, so it is refused there. 'file_mtime' is a filesystem timestamp and is reset by git clone. null for tables written before this existed."
            }
          }
        },
        "sales": {
          "type": "object",
          "required": [
            "months",
            "first",
            "last",
            "full_annual_cycle",
            "imported_this_run"
          ],
          "properties": {
            "months": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "first": {
              "type": [
                "string",
                "null"
              ]
            },
            "last": {
              "type": [
                "string",
                "null"
              ]
            },
            "full_annual_cycle": {
              "type": "boolean"
            },
            "imported_this_run": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "ADR-017. True when this run imported sales rows; false when it continued on evidence already on disk; null when the import step failed and the question is unanswered."
            },
            "reconcile_before": {
              "type": [
                "string",
                "null"
              ],
              "description": "The month boundary reconciliation actually used, as YYYY-MM: only months STRICTLY BEFORE it are counted, because sales after a stock count cannot explain a shortfall observed at it. Differs from months/first/last whenever the count predates the last report \u2014 on 2026-09-21 the span was seven months and no entry used more than five. Published because OQ-201 was closed on \"window vintages published so misalignment is visible\", and this was the one window that was not. Null means the stock date is unusable and reconciliation refuses (see stock_date.py); it never means the full span. NOT required \u2014 artefacts published before this existed do not carry it."
            }
          }
        },
        "competitor": {
          "type": "object",
          "required": [
            "snapshot_date",
            "sources"
          ],
          "properties": {
            "snapshot_date": {
              "type": [
                "string",
                "null"
              ]
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "sales_daily": {
          "type": "object",
          "description": "ADR-030 (Phase 5 Task 5.2): what the daily sales reports say arrived, read from the rows present. missing_days and deliveries_missing_days look back over the evidence window plus the freshness limit. NOT required: artefacts published before the daily reports existed do not carry it.",
          "required": [
            "first_day",
            "last_day",
            "report_days",
            "missing_days",
            "deliveries_missing_days"
          ],
          "properties": {
            "first_day": {
              "type": [
                "string",
                "null"
              ]
            },
            "last_day": {
              "type": [
                "string",
                "null"
              ]
            },
            "report_days": {
              "type": [
                "integer",
                "null"
              ]
            },
            "missing_days": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deliveries_missing_days": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "owner_state": {
          "type": "object",
          "required": [
            "pulled_at",
            "status"
          ],
          "properties": {
            "pulled_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "enum": [
                "available",
                "unavailable"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ],
              "description": "Why this owner state is what it is: 'from_mirror' when replayed from the committed replica rather than pulled live, an unavailability reason when status is unavailable, null on a live pull."
            },
            "devices": {
              "type": "object",
              "description": "ADR-021. How many distinct browser profiles have written owner state, and when each last did. NOT required, for the same reason as vintages.pos.as_of_source: an artefact published before the register existed does not carry it, and the committed artefact is validated by CI. Every artefact this engine builds does carry it \u2014 tests/engine/test_inputs.py holds that, where the schema cannot. Never the device_id: it exists so the engine can count distinct writers and is not published. It counts profiles, not devices \u2014 clearing site data mints a new id and two browsers on one phone count twice \u2014 so it is neither a floor nor a ceiling on the physical fleet.",
              "required": [
                "status",
                "count",
                "last_seen_at"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "available",
                    "unavailable"
                  ]
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "'not_registered' when no profile has registered yet, 'owner_state_unavailable' when the pull itself failed, null when available."
                },
                "count": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1,
                  "description": "Null when unavailable, never 0 \u2014 nobody having opened the app and nobody having registered are not the same fact (ARCH-DRIVER-002)."
                },
                "last_seen_at": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Sorted ascending so the artefact stays deterministic. Carries only the timestamps that parse, so it may be shorter than count."
                }
              }
            }
          }
        }
      }
    },
    "thresholds": {
      "type": "object"
    },
    "value_kinds_present": {
      "type": "array",
      "items": {
        "enum": [
          "per_sale"
        ]
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/capability"
      }
    },
    "figures": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "value",
          "unit",
          "inputs",
          "thresholds"
        ],
        "properties": {
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "thresholds": {
            "type": "object"
          }
        }
      }
    },
    "inputs_digest": {
      "type": "string",
      "description": "Hex digest over the content of every input the run read. Two runs over identical inputs produce an identical digest; a changed policy constant changes it, because a figure computed under a different threshold is a different figure."
    },
    "population": {
      "enum": [
        "living",
        "whole"
      ],
      "description": "ADR-020. Which catalogue every count was taken over. 'whole' includes automatically withdrawn products, which is what D-14 requires while GAP-009 is open."
    }
  },
  "$defs": {
    "value": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "amount",
        "kind",
        "certainty"
      ],
      "properties": {
        "amount": {
          "type": "number"
        },
        "kind": {
          "enum": [
            "per_sale"
          ]
        },
        "certainty": {
          "enum": [
            "confirmed",
            "estimated"
          ]
        }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "signal_family",
        "capability",
        "barcode",
        "product_name",
        "department",
        "action",
        "characterisation",
        "evidence",
        "value",
        "ordering_key",
        "actionable",
        "not_actionable_reason",
        "attention"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "signal_family": {
          "enum": [
            "recon.impossible_opening",
            "hygiene.negative_stock",
            "hygiene.no_identifier",
            "hygiene.absent_price",
            "hygiene.conflicting_duplicate",
            "price.inverted",
            "price.above_ceiling",
            "competitor.policy_breach",
            "competitor.purchase_cost",
            "catalogue.idle",
            "catalogue.implausible_quantity",
            "margin.below_cost",
            "order.suggestion",
            "assortment.market_ran_out",
            "shelf.plan"
          ]
        },
        "capability": {
          "type": "string"
        },
        "barcode": {
          "type": [
            "string",
            "null"
          ]
        },
        "product_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "department": {
          "type": [
            "string",
            "null"
          ]
        },
        "action": {
          "enum": [
            "verify_price",
            "count_product",
            "fix_record",
            "decide_idle",
            "review_policy",
            "check_purchase_cost",
            "place_order",
            "try_product",
            "arrange_shelf",
            "raise_delivery_price"
          ]
        },
        "characterisation": {
          "type": "string"
        },
        "evidence": {
          "type": "object"
        },
        "value": {
          "$ref": "#/$defs/value"
        },
        "ordering_key": {
          "type": "object",
          "required": [
            "name",
            "value"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "value": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "actionable": {
          "type": "boolean"
        },
        "not_actionable_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "attention": {
          "enum": [
            "today",
            "review"
          ]
        }
      },
      "allOf": [
        {
          "comment": "F8-S1 FR-154 and INV-069 (Phase 5 Task 5.8): an order suggestion publishes the facts it was computed from, and never a value. publish.py also refuses any money-named field at any depth, which a schema cannot say.",
          "if": {
            "properties": {
              "signal_family": {
                "const": "order.suggestion"
              }
            },
            "required": [
              "signal_family"
            ]
          },
          "then": {
            "properties": {
              "action": {
                "const": "place_order"
              },
              "value": {
                "type": "null"
              },
              "evidence": {
                "type": "object",
                "required": [
                  "order_day",
                  "cycle",
                  "schedule",
                  "schedule_changed",
                  "window",
                  "weekly_units",
                  "daily_mean",
                  "boost",
                  "adjusted_daily_mean",
                  "expected_sales",
                  "count",
                  "stock_now",
                  "stock_at_order_day",
                  "shelf_life",
                  "capped",
                  "kind",
                  "quantity"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "net",
                      "gross"
                    ]
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "boost": {
                    "type": "object",
                    "required": [
                      "applied",
                      "not_applied_because"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "comment": "F9-S1 FR-168, FR-169 and INV-081 (Phase 6 Task 6.2): an assortment-gap entry publishes what the market was seen doing, and never a value. publish.py also refuses any money-named field at any depth.",
          "if": {
            "properties": {
              "signal_family": {
                "const": "assortment.market_ran_out"
              }
            },
            "required": [
              "signal_family"
            ]
          },
          "then": {
            "properties": {
              "action": {
                "const": "try_product"
              },
              "value": {
                "type": "null"
              },
              "evidence": {
                "type": "object",
                "required": [
                  "stores_ran_out",
                  "nights_ran_out",
                  "last_ran_out",
                  "listed_at",
                  "window",
                  "market_name"
                ]
              }
            }
          }
        },
        {
          "comment": "F12-S1 FR-192, ADR-038 (Phase 8 Task 8.3): a fixture's plan. It names a fixture, not a product, and never carries a value.",
          "if": {
            "properties": {
              "signal_family": {
                "const": "shelf.plan"
              }
            },
            "required": [
              "signal_family"
            ]
          },
          "then": {
            "properties": {
              "action": {
                "const": "arrange_shelf"
              },
              "value": {
                "type": "null"
              },
              "barcode": {
                "type": "null"
              },
              "product_name": {
                "type": "null"
              },
              "department": {
                "type": "null"
              },
              "evidence": {
                "type": "object",
                "required": [
                  "fixture",
                  "plan_date",
                  "plan_window",
                  "state",
                  "shelves"
                ]
              }
            }
          }
        }
      ]
    },
    "capability": {
      "comment": "Extra properties are allowed: catalogue_lifecycle adds withdrawn/statement/provisional and owner_questions adds limit/items/suppressed (design §11.4).",
      "type": "object",
      "required": [
        "id",
        "spec",
        "requires",
        "status",
        "unavailable_reason",
        "window",
        "thresholds",
        "counts",
        "entries",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "spec": {
          "type": "string"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "unavailable_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "window": {
          "type": [
            "object",
            "null"
          ]
        },
        "thresholds": {
          "type": "object"
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "comment": "Phase 5 Task 5.9: every owner question, cost or disagreement, has one published shape.",
          "if": {
            "properties": {
              "id": {
                "const": "owner_questions"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/question"
                }
              }
            }
          }
        }
      ]
    },
    "question": {
      "comment": "SPEC-005 and F8-S1 FR-158 (ADR-034). A question is identified by fact and barcode, and its answer lives at answers[barcode][fact]. A disagreement carries no ₪ figure (C-68, ADR-027) and offers the four answers FR-158 names.",
      "type": "object",
      "required": [
        "question_id",
        "barcode",
        "fact",
        "why",
        "expected_value"
      ],
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "barcode": {
          "type": "string"
        },
        "product_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "department": {
          "type": [
            "string",
            "null"
          ]
        },
        "fact": {
          "enum": [
            "cost_price",
            "market_disagreement"
          ]
        },
        "why": {
          "type": "object"
        },
        "expected_value": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "fact": {
                "const": "market_disagreement"
              }
            },
            "required": [
              "fact"
            ]
          },
          "then": {
            "required": [
              "answers"
            ],
            "properties": {
              "expected_value": {
                "type": "null"
              },
              "answers": {
                "type": "array",
                "items": {
                  "enum": [
                    "shelf_place",
                    "price",
                    "weak_market",
                    "sells_elsewhere"
                  ]
                }
              },
              "why": {
                "type": "object",
                "required": [
                  "stores_out",
                  "days_absent",
                  "no_sales_row"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "money_at_stake"
                      ]
                    },
                    {
                      "required": [
                        "money_basis"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
