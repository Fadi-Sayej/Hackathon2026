{
  "name": "temp-app",
  "private": true,
  "engines": {
    "node": ">=22.14.0"
  },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:bundle": "node scripts/check_bundle_size.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "discover:alonit-network": "node scripts/discover-alonit-network.mjs",
    "collect:delivery-venue": "python3 scripts/run_delivery_venue_connector.py",
    "collect:alonit-signals": "python3 scripts/run_alonit_signal_pipeline.py",
    "check:firebase-live": "node scripts/check_firebase_live.mjs",
    "check:firebase": "node scripts/check_firebase_config.mjs",
    "preflight": "bash scripts/preflight_deploy.sh",
    "data:velocity": "python3 scripts/build_velocity_from_snapshots.py",
    "data:lead-times": "python3 scripts/export_supplier_lead_times.py",
    "check:restocks": "python3 scripts/reconcile_restocks.py",
    "data:quality": "python3 scripts/check_import_quality.py",
    "test": "vitest run",
    "test:py": "python3 -m pytest tests -q",
    "test:py:fast": "python3 -m pytest tests -q -m \"not slow\"",
    "classify:store-types": "python3 scripts/classify_store_types.py",
    "data:refresh": "python3 scripts/run_engine.py",
    "engine:print": "python3 scripts/run_engine.py --print",
    "data:snapshots": "python3 scripts/compare_pos_snapshots.py",
    "test:watch": "vitest",
    "test:pipeline": "python3 scripts/smoke_test_pipeline.py",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run test && npm run test:e2e",
    "doctor": "node scripts/doctor.mjs",
    "audit:ui": "node scripts/ui-audit.mjs",
    "check:signals": "npm run check:signals:v1 && npm run check:independence && npm run check:order-signals",
    "check:signals:v1": "python3 scripts/check_v1_signals.py",
    "check:independence": "python3 scripts/check_independence.py",
    "check:order-signals": "python3 scripts/check_order_signals.py",
    "check:rules": "python3 scripts/check_firestore_rules.py",
    "check:surface": "vitest run src/surface/__tests__/checkpoint2.test.jsx",
    "figures": "python3 scripts/figures.py",
    "figures:whole": "python3 scripts/figures.py --population whole"
  },
  "dependencies": {
    "firebase": "^12.13.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.62.1",
    "vite": "^8.0.12",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.1"
  }
}
