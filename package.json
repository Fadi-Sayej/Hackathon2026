{
  "name": "temp-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "discover:alonit-network": "node scripts/discover-alonit-network.mjs",
    "collect:delivery-venue": "python3 scripts/run_delivery_venue_connector.py",
    "collect:alonit-signals": "python3 scripts/run_alonit_signal_pipeline.py",
    "normalize:data": "node scripts/normalize-datasets.mjs",
    "data:dashboard": "python3 scripts/export_dashboard_data.py",
    "check:firebase-live": "node scripts/check_firebase_live.mjs",
    "check:firebase": "node scripts/check_firebase_config.mjs",
    "preflight": "bash scripts/preflight_deploy.sh",
    "data:velocity": "python3 scripts/build_velocity_from_snapshots.py",
    "data:lead-times": "python3 scripts/export_supplier_lead_times.py",
    "data:quality": "python3 scripts/check_import_quality.py",
    "pilot:daily": "bash scripts/pilot_daily.sh",
    "test": "vitest run",
    "test:py": "python3 -m pytest tests -q",
    "data:store-types": "python3 scripts/export_store_types.py",
    "classify:store-types": "python3 scripts/classify_store_types.py",
    "audit:store-format": "node scripts/audit-store-format.mjs",
    "data:refresh": "python3 scripts/refresh_pipeline.py",
    "data:snapshots": "python3 scripts/compare_pos_snapshots.py",
    "test:watch": "vitest",
    "test:pipeline": "python3 scripts/smoke_test_pipeline.py",
    "sprint2": "npm run normalize:data",
    "sprint3": "npm run normalize:data",
    "sprint4": "npm run normalize:data && npm run lint && npm run build",
    "sprint7": "npm run normalize:data && npm run lint && npm run build"
  },
  "dependencies": {
    "firebase": "^12.13.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^30.0.1",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  }
}
